<manifest package="com.lightstick.internal"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE permissions (if not already merged from public module) -->
    <!-- Android 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 and below (minSdk 26): legacy Bluetooth permissions for GATT connect/bond.
         Location is intentionally NOT declared here: connecting by MAC does not need it.
         An app that calls startScan() on Android 11 and below must declare
         ACCESS_FINE_LOCATION itself (OS requirement for BLE scan results). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <application />
</manifest>
